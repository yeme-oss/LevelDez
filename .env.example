# Copy to .env (never commit .env). Real environment variables override these.

# Decision-1 (the yes/no model that drives the editor buttons) via OpenRouter - needed for AI routing/autopilot.
# Without it the editor still works (keyword routing, rule-based autopilot).
OPENROUTER_API_KEY=
DECISION_MODEL=microsoft/microsoft-decision-1

# Only needed to (re)generate wall art and textures with Nano Banana (tools/gothic/gen_art.py, gen_textures.py). ~$0.034 per image.
GEMINI_API_KEY=

# Optional
# 
# PORT=5173
# HOST=127.0.0.1
# BLENDER_PORT=9876
# LEVELDEZ_ALLOW_RAW_BLENDER=0
# LEVELDEZ_ROOT=/path/to/LevelDez      (for the Blender scripts in tools/)
